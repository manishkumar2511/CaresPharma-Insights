@page "/"
@inject HttpClient Http
@using System.Net.Http.Json

<div class="chat-container">
    <div class="chat-history" id="chatHistory">
        @if (messages.Count == 0)
        {
            <div class="message ai" style="align-self: center; text-align: center; margin-top: 50px; background: transparent; border: none; box-shadow: none;">
                <h3 style="color: #0f172a; font-weight: 800; font-size: 26px; margin-bottom: 12px;">Welcome to CaresPharma <span style="color: #00bcd4;">Insights</span></h3>
                <p style="color: #64748b; font-size: 16px; max-width: 500px; margin: 0 auto;">Ask me anything about your platform's data. I can provide insights for superadmins, store managers, and network partners.</p>
                <div style="margin-top: 24px; display: flex; flex-direction: column; gap: 10px; align-items: center;">
                    <div @onclick="@(() => ApplyPrompt("Show me the total number of users."))" style="background: #ffffff; border: 1px solid #e2e8f0; padding: 12px 20px; border-radius: 8px; color: #64748b; font-size: 14px; box-shadow: 0 2px 5px rgba(0,0,0,0.02); width: 100%; max-width: 400px; text-align: left; cursor: pointer;">
                        <span style="color: #00bcd4; font-size: 16px;">?</span> <span style="color: #0f172a; font-weight: 600; margin-left: 8px;">"Show me the total number of users."</span>
                    </div>
                    <div @onclick="@(() => ApplyPrompt("Aaj ki total sales report dikhao."))" style="background: #ffffff; border: 1px solid #e2e8f0; padding: 12px 20px; border-radius: 8px; color: #64748b; font-size: 14px; box-shadow: 0 2px 5px rgba(0,0,0,0.02); width: 100%; max-width: 400px; text-align: left; cursor: pointer;">
                        <span style="color: #00bcd4; font-size: 16px;">?</span> <span style="color: #0f172a; font-weight: 600; margin-left: 8px;">"Aaj ki total sales report dikhao."</span>
                    </div>
                </div>
            </div>
        }
        else
        {
            @foreach (ChatMessage msg in messages)
            {
                <div class="message @(msg.IsUser ? "user" : "ai")">
                    @if (msg.IsUser)
                    {
                        @msg.Content
                    }
                    else
                    {
                        @((MarkupString)Markdig.Markdown.ToHtml(msg.Content))
                    }
                </div>
            }

            @if (isTyping)
            {
                <div class="message ai typing-indicator">
                    <div class="dot"></div>
                    <div class="dot"></div>
                    <div class="dot"></div>
                </div>
            }
        }
    </div>

    <div class="input-area">
        <form @onsubmit="SendMessage" class="input-box">
            <input @bind="userInput" @bind:event="oninput" type="text" class="chat-input" placeholder="Type your query in Hindi or English..." disabled="@isTyping" />
            <button type="submit" class="send-btn" disabled="@(string.IsNullOrWhiteSpace(userInput) || isTyping)">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="22" y1="2" x2="11" y2="13"></line>
                    <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                </svg>
            </button>
        </form>
    </div>
</div>

@code {
    private string userInput = "";
    private bool isTyping = false;
    private List<ChatMessage> messages = new();

    private void ApplyPrompt(string prompt)
    {
        userInput = prompt;
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(userInput)) return;

        string currentMessage = userInput;
        messages.Add(new ChatMessage { Content = currentMessage, IsUser = true });
        userInput = "";
        isTyping = true;
        StateHasChanged();

        try
        {
            HttpResponseMessage response = await Http.PostAsJsonAsync("api/chat", new { Message = currentMessage });
            
            if (response.IsSuccessStatusCode)
            {
                ChatResponse? result = await response.Content.ReadFromJsonAsync<ChatResponse>();
                messages.Add(new ChatMessage { Content = result?.Reply ?? "Error getting response", IsUser = false });
            }
            else
            {
                messages.Add(new ChatMessage { Content = $"Sorry, API Error: {response.StatusCode}", IsUser = false });
            }
        }
        catch (Exception ex)
        {
            messages.Add(new ChatMessage { Content = "Error connecting to the backend server. Please try again later.", IsUser = false });
        }
        finally
        {
            isTyping = false;
            StateHasChanged();
        }
    }

    public class ChatMessage
    {
        public string Content { get; set; } = "";
        public bool IsUser { get; set; }
    }
    
    public class ChatResponse
    {
        public string Reply { get; set; } = "";
    }
}
